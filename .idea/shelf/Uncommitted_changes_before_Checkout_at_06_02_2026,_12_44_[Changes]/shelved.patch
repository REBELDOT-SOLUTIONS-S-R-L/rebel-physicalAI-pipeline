<+>name: GR00T Fine-tune\non:\n  workflow_dispatch:\n  workflow_run:\n    workflows: [\"GR00T Setup\"]\n    types: [completed]\n\njobs:\n  gr00t-finetune:\n    runs-on: ubuntu-latest\n    if: ${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success' }}\n    \n    steps:\n      - name: Step 0 - Install Brev CLI, login and enter Brev to create ssh config\n        run: |\n          sudo bash -c \"$(curl -fsSL https://raw.githubusercontent.com/brevdev/brev-cli/main/bin/install-latest.sh)\"\n          echo \"No\" | brev login --token ${{ secrets.BREV_TOKEN }} --skip-browser\n          brev shell ${{ vars.BREV_INSTANCE_NAME }}\n\n      - name: Step 1 - Download Dataset\n        run: ssh -F ~/.brev/ssh_config ${{ vars.BREV_INSTANCE_NAME }} \"cd ~/Isaac-GR00T;\n          export PATH=\\$HOME/.local/bin:\\$PATH;\n          uv run hf download VoicAndrei/${{ vars.HF_REPO_NAME }} --repo-type dataset --local-dir ./hf_datasets/${{ vars.HF_REPO_NAME }};\n          \"\n      \n      - name: Step 2 - Run finetune\n        run: ssh -F ~/.brev/ssh_config ${{ vars.BREV_INSTANCE_NAME }} \"cd ~/Isaac-GR00T;\n          export NUM_GPUS=1;\n          export PATH=\\$HOME/.local/bin:\\$PATH;\n          CUDA_VISIBLE_DEVICES=0;\n          uv run python gr00t/experiment/launch_finetune.py --base_model_path nvidia/GR00T-N1.6-3B --dataset_path ./hf_datasets/${{ vars.HF_REPO_NAME }} --modality_config_path ~/modality_files/${{ vars.MODALITY_FILE }} --embodiment_tag NEW_EMBODIMENT --num_gpus \\$NUM_GPUS --output_dir tmp/${{ vars.HF_REPO_NAME }} --save_steps ${{ vars.SAVE_STEPS }} --save_total_limit 5 --max_steps ${{ vars.MAX_STEPS }} --warmup_ratio 0.05 --weight_decay 1e-5 --learning_rate 1e-4 --global_batch_size 32 --color_jitter_params brightness 0.3 contrast 0.4 saturation 0.5 hue 0.08 --dataloader_num_workers 4;\n          \"\n
